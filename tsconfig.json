{
  // Only this repo's own TypeScript. Everything under plugins/ is
  // upstream content vendored verbatim by `bun run sync` — it is never
  // hand-edited, so type-checking it can only produce errors we are not
  // allowed to fix (e.g. manticore ships .mjs motion-graphics templates
  // with JSX-ish syntax).
  "include": ["scripts/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
